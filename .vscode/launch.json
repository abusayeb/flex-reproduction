{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run everything (main.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONPATH": "${workspaceFolder}"},
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run one part (main.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["${input:part}"],
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONPATH": "${workspaceFolder}"},
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run the unit tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "part",
      "type": "pickString",
      "description": "Which part to run",
      "options": ["basics", "table1", "op_errors", "table2", "figures"],
      "default": "table1"
    }
  ]
}
